{
  "name": "sokcho-moa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:mobile": "pnpm --filter @sokcho-moa/mobile lint",
    "places:generate": "node scripts/generate-place-assets.mjs",
    "places:check": "node scripts/generate-place-assets.mjs --check",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "pnpm --filter @sokcho-moa/mobile typecheck",
    "test": "vitest run",
    "test:mobile": "pnpm --filter @sokcho-moa/mobile test",
    "test:notifications": "vitest run tests/notification-policy.test.ts tests/notification-migration.test.ts tests/notification-dispatch-function.test.ts",
    "test:e2e": "playwright test",
    "notifications:dry-run": "node --experimental-strip-types scripts/notification-dry-run.mjs",
    "verify:local-mobile-backend": "node scripts/verify-local-mobile-backend.mjs",
    "mobile:start": "pnpm --filter @sokcho-moa/mobile start",
    "mobile:ios": "pnpm --filter @sokcho-moa/mobile ios",
    "mobile:android": "pnpm --filter @sokcho-moa/mobile android"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.1",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  },
  "packageManager": "pnpm@9.6.0"
}
