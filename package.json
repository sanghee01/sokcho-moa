{
  "name": "sokcho-moa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "places:generate": "node scripts/generate-place-assets.mjs",
    "places:check": "node scripts/generate-place-assets.mjs --check",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x realtime,edge-runtime,logflare,vector,imgproxy,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types --lang typescript --schema public > lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.61.0",
    "next": "16.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@9.6.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    },
    "overrides": {
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.5",
      "nanoid": "^3.3.17",
      "browserslist": "4.29.5",
      "baseline-browser-mapping": "2.11.35",
      "source-map-js": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "pnpm": ">=9 <10"
  }
}
