{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env*.local)",
      "Edit(/.env)",
      "Edit(/.env*.local)",
      "Edit(/lib/supabase/database.types.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-tool-use.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
