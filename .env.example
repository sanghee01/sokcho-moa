# demo: 자격증명 없이 샘플 데이터로 실행, supabase: 실제 프로젝트 데이터 사용
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 말고 브라우저 코드에서 import하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 공개 제보·의견 요청 제한에서 IP를 HMAC 처리하는 서버 전용 비밀값입니다.
# 예: openssl rand -hex 32
SUBMISSION_RATE_LIMIT_HMAC_SECRET=

# 선택: 외부 수집기가 /api/revalidate를 호출할 때 사용하는 서버 전용 비밀값
REVALIDATE_SECRET=
