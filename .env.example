# 로컬 개발: `pnpm db:start`로 로컬 Supabase를 띄운 뒤 `pnpm exec supabase status`의 값을 넣는다.
# 운영: Vercel 프로젝트 환경 변수에 같은 이름으로 넣는다.
# 비워 두면 Vercel에서는 배포 주소(운영: VERCEL_PROJECT_PRODUCTION_URL)를, 로컬에서는 http://localhost:3000을 쓴다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Dashboard > Project Settings > API Keys (로컬: API_URL, PUBLISHABLE_KEY)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 지도 탭(/map)의 네이버 지도. 네이버 클라우드 콘솔 > Maps > Application의 인증 정보에 있는 Client ID(Client Secret 아님).
# 브라우저에 그대로 보이는 값이고, 콘솔에 등록한 Web 서비스 URL에서만 지도가 뜬다. 비워 두면 지도 대신 안내 문구가 보인다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 서버 전용 secret key(sb_secret_...). RLS를 거치지 않으므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 로컬: SECRET_KEY. legacy service_role JWT 키는 2027년 초 폐기 예정이다.
SUPABASE_SECRET_KEY=

# 방문자 제보·의견 요청 제한에서 IP를 HMAC 처리하는 서버 전용 비밀값(32자 이상).
# 예: openssl rand -hex 32
SUBMISSION_RATE_LIMIT_HMAC_SECRET=
